      <sparkle:version>2</sparkle:version>
      <sparkle:shortVersionString>1.0.0-beta.3</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
      <description><![CDATA[
        <p>Third beta of AirothyServer — localization release.</p>
        <ul>
          <li>Full localization across 8 languages (English, Korean, Japanese, Simplified Chinese, Spanish, French, German, Arabic).</li>
          <li>Pairing and disconnect errors now appear in the iPhone's language instead of the Mac's.</li>
          <li>Fixed several strings that always showed in English regardless of system language.</li>
        </ul>
        <p>Backwards-compatible with existing paired iPhones — no re-pairing needed.</p>
      ]]></description>
